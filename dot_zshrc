# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
ZSH_THEME="robbyrussell"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-history-substring-search
#    git
#    git-commit

    vi-mode
)

export EDITOR=vim

fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
autoload -U compinit && compinit
source "$ZSH/oh-my-zsh.sh"

# homebrew
export HOMEBREW_NO_AUTO_UPDATE=1

# script
export SCRIPT_HOME="$HOME/.script"
export PATH=$SCRIPT_HOME:$PATH

# key
source ~/.access_key_rc

# oss util
export OSS_UTIL_PATH="$HOME/soft/ossutil-2.2.0-mac-amd64"
export PATH=$OSS_UTIL_PATH:$PATH

# jmeter
export JMETER_HOME="$HOME/soft/apache-jmeter-5.6.3"
export PATH=$JMETER_HOME/bin:$PATH

#vcpkg
export VCPKG_ROOT="$HOME/soft/vcpkg"
export PATH=$VCPKG_ROOT:$PATH

# customer command
gco(){
    git branch | fzf | xargs git checkout
}
gsp(){
    git stash list | fzf | awk -F '{|}' '{print $2}' | xargs git stash pop
}
export PATH="/usr/local/opt/mysql-client/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"

# yazi
alias y="yazi"

# oxker
alias oxker="oxker --config-file $HOME/.config/oxker/config.toml"

# opencode
export OPENCODE_DISABLE_LSP_DOWNLOAD=true
# 把 lsp-tools-mcp 的安装决策文件从 ~/.codex 重定向到 opencode 配置目录
# (oh-my-openagent 的 LSP MCP 默认写 ~/.codex/lsp-install-decisions.json, 会自动创建 ~/.codex)
export LSP_TOOLS_MCP_INSTALL_DECISIONS="$HOME/.config/opencode/lsp-install-decisions.json"

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/platform-tools:$PATH"

# uv 只使用 managed python，绝不碰 brew/system python
export UV_PYTHON_PREFERENCE=only-managed

# Rust (brew rustup — keg-only，需手动加 PATH)
export PATH="/usr/local/opt/rustup/bin:$PATH"

# Java (brew openjdk@21 — keg-only)
export JAVA_HOME="/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
export PATH="$JAVA_HOME/bin:$PATH"

# fnm (Node 版本管理，激活后会自动注入 node 路径并按 .node-version 切换)
eval "$(fnm env --use-on-cd --shell zsh)"
