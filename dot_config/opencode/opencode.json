{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "autoshare": false,
  "share": "disabled",
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "target/**",
      "build/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.yml": "deny",
      "*.properties": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "*.pdf": "deny",
      "*.zip": "deny",
      "*.tar.gz": "deny",
      "*keystore": "deny",
      "*truststore": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todoread": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow"
  },
  "plugin": [
    "oh-my-openagent"
  ]
}
